# Copie este arquivo para .env e preencha os valores reais.
# O arquivo .env NUNCA deve ser commitado (já está no .gitignore).

# Provedor de LLM: openai | anthropic | google | ollama ...
LLM_PROVIDER=openai
# Modelo usado pelo provedor escolhido
LLM_MODEL=gpt-4o-mini
# Chave de API do provedor (deixe vazio se usar um modelo local)
LLM_API_KEY=

# Nível de log: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
